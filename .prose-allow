# Exceptions to scripts/check-prose.py, one glob per line, each with its reason.
# docs/archive/ (the superseded DIY pendant) and docs/concepts/ (mockups of the Italian UI) are
# allowed by default.

# The check itself holds the list of Italian words it looks for.
scripts/check-prose.py

# The String Catalogs hold the Italian translation of the app's UI, by design.
app/**/*.xcstrings
