        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascrizione"
          }
        }
      }
    },
    "Transcripts are only on the server. None stay on the phone." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trascrizioni si leggono solo sul server. Sul telefono non ne resta nessuna."
