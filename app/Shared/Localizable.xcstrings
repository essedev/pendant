    "Recording stopped at %@. If the pendant comes back within %@ the same conversation continues; after that it stays paused." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recording stopped at %1$@. If the pendant comes back within %2$@ the same conversation continues; after that it stays paused."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione si è fermata alle %1$@. Se il ciondolo torna entro %2$@ continua la stessa conversazione, dopo resta in pausa."
          }
        }
      }
    },
    "Red stays the color of recording and amber the color of warnings, in every theme. The theme applies to the Live Activity too." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rosso resta quello della registrazione e l’ambra quello degli avvisi, in ogni tema. Il tema vale anche per l’attività in tempo reale."
          }
        }
      }
    },
