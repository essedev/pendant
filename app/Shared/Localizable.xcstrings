    },
    "Follows recording" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segue la registrazione"
          }
        }
      }
    },
    "For pausing from the Action button and Control Center: Settings, Outside the app." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per la pausa dal tasto Azione e dal Centro di Controllo: Impostazioni, Fuori dall’app."
          }
        }
      }
    },
    "Forget %@?" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimenticare %@?"
