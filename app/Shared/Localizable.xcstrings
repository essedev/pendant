            "state" : "translated",
            "value" : "Mettilo in carica appena puoi."
          }
        }
      }
    },
    "Charge it as soon as you can. When it’s off it records nothing, not even to its own memory." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettilo in carica appena puoi. Da spento non registra niente, nemmeno nella sua memoria."
          }
        }
      }
    },
    "Charge it for a few minutes and keep it next to the phone." : {
      "localizations" : {
