    },
    "On %@ the app stops opening: it’s signed with a free account, which lasts 7 days. To renew it, connect the iPhone to the Mac and run the install again from Xcode. Settings and token stay." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ l’app smette di aprirsi: è firmata con un account gratuito, che dura 7 giorni. Per rinnovarla collega l’iPhone al Mac e rilancia l’installazione da Xcode. Impostazioni e token restano."
          }
        }
      }
    },
