    },
    "Then only the notification on the phone" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poi solo la notifica sul telefono"
          }
        }
      }
    },
    "There’s a pendant nearby. If it’s yours, connect it." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’è un ciondolo qui vicino. Se è il tuo, collegalo."
          }
        }
      }
    },
    "There’s room for one control on each side. It works with the phone locked too." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sta un controllo per lato. Funziona anche col telefono bloccato."
          }
        }
      }
    },
    "This copy of the app has no signing profile with an expiry." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa copia dell’app non ha un profilo di firma con scadenza."
          }
        }
      }
    },
    "This version of the app knows %@. It records and pauses as before; the pendant’s new features stay off until you update the app." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione dell’app conosce il %@. Registra e mette in pausa come prima; le funzioni nuove del ciondolo restano spente finché non aggiorni l’app."
          }
        }
      }
    },
    "Today" : {
      "localizations" : {
